# Google Maps Platform key. Enable Maps JavaScript API and Geocoding API.
# Chiave Google Maps Platform. Abilita Maps JavaScript API e Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: endpoint compatible with the CityMirror proposal JSON contract or Ollama instance (e.g. http://localhost:11434/api/chat).
# Opzionale: endpoint compatibile con CityMirror o istanza Ollama (es. http://localhost:11434/api/chat).
VITE_AI_ENDPOINT=
# Optional Ollama model name (defaults to llama3).
# Modello Ollama facoltativo (predefinito: llama3).
VITE_OLLAMA_MODEL=llama3

